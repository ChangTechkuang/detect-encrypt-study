// Scores the rule engine (src/lib/classify.ts) on a dataset: node eval/evaluate.mts [dev|test]
// Writes eval/report-<set>.md. If data/ai-before.json / ai-after.json exist (from run-ai.mjs), compares on the same samples.
import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";
const { classify } = await import(new URL("../src/lib/classify.ts", import.meta.url).href);

type Sample = { id: string; algorithm: string; category: string; plaintext: string; encoding: string; value: string; bytes: number };
type Pred = { category: string; confidence: string; algorithm: string };
const here = path.dirname(fileURLToPath(import.meta.url));
const setName = process.argv[2] ?? "test";
const { samples } = JSON.parse(fs.readFileSync(path.join(here, `data/${setName}.json`), "utf8")) as { samples: Sample[] };

const CLASSES = ["hashing", "symmetric", "asymmetric"];
const PRED = [...CLASSES, "encoding", "UNKNOWN"];
const label = (c: string) => ({ hashing: "Hashing", symmetric: "Symmetric", asymmetric: "Asymmetric", encoding: "Encoding", UNKNOWN: "UNKNOWN" })[c] ?? c;

/** Algorithm check: right name, wrong name, or honestly UNKNOWN. */
function algoOutcome(s: Sample, predicted: string) {
  if (/^UNKNOWN$/i.test(predicted)) return "unknown";
  const a = s.algorithm;
  const want = a.startsWith("ECIES") ? "ECIES" : a.startsWith("ECDSA") ? "ECDSA" : a.startsWith("ECC") ? "ECC public key" : a.startsWith("PBKDF2") ? "PBKDF2"
    : a.startsWith("ARIA") ? "ARIA" : a.startsWith("RSA") ? a.slice(0, 8) : a.startsWith("AES") ? a.slice(0, 7) : a.replace("-Poly1305", "");
  return predicted.toUpperCase().includes(want.toUpperCase()) ? "right" : "wrong";
}

function metrics(rows: { truth: string; pred: string }[]) {
  const m = Object.fromEntries(CLASSES.map((t) => [t, Object.fromEntries(PRED.map((p) => [p, 0]))]));
  for (const r of rows) m[r.truth][PRED.includes(r.pred) ? r.pred : "UNKNOWN"]++;
  const per = CLASSES.map((c) => {
    const tp = m[c][c], predicted = CLASSES.reduce((a, t) => a + m[t][c], 0), actual = PRED.reduce((a, p) => a + m[c][p], 0);
    const precision = predicted ? tp / predicted : 0, recall = actual ? tp / actual : 0;
    return { c, precision, recall, f1: precision + recall ? 2 * precision * recall / (precision + recall) : 0, support: actual };
  });
  const correct = rows.filter((r) => r.truth === r.pred).length, answered = rows.filter((r) => CLASSES.includes(r.pred) || r.pred === "encoding").length;
  return { m, per, accuracy: correct / rows.length, coverage: answered / rows.length, selective: answered ? correct / answered : 0, correct, answered, n: rows.length };
}

const pct = (x: number) => (x * 100).toFixed(1) + "%";
function metricsMd(title: string, r: ReturnType<typeof metrics>) {
  const lines = [`### ${title}`, "", "Confusion matrix (rows = actual, columns = detected):", "",
    `| Actual \\ Detected | ${PRED.map(label).join(" | ")} | Total |`, `|---|${PRED.map(() => "---:").join("|")}|---:|`,
    ...CLASSES.map((t) => `| **${label(t)}** | ${PRED.map((p) => (t === p ? `**${r.m[t][p]}**` : r.m[t][p])).join(" | ")} | ${PRED.reduce((a, p) => a + r.m[t][p], 0)} |`),
    "", "| Class | Precision | Recall | F1 | Support |", "|---|---:|---:|---:|---:|",
    ...r.per.map((p) => `| ${label(p.c)} | ${pct(p.precision)} | ${pct(p.recall)} | ${pct(p.f1)} | ${p.support} |`),
    `| **Macro average** | ${pct(r.per.reduce((a, p) => a + p.precision, 0) / 3)} | ${pct(r.per.reduce((a, p) => a + p.recall, 0) / 3)} | ${pct(r.per.reduce((a, p) => a + p.f1, 0) / 3)} | ${r.n} |`,
    "", `- **Overall accuracy: ${pct(r.accuracy)}** (${r.correct}/${r.n}; UNKNOWN counts as wrong)`,
    `- Coverage: ${pct(r.coverage)} answered (${r.answered}/${r.n}); the rest were UNKNOWN`,
    `- Accuracy when it answered: ${pct(r.selective)}`, ""];
  return lines.join("\n");
}

// ---- rule engine on every sample
const rule = new Map(samples.map((s) => { const c = classify(s.value); return [s.id, c]; }));
const ruleRows = samples.map((s) => ({ truth: s.category, pred: rule.get(s.id)!.category }));
const ruleM = metrics(ruleRows);

const algo = { right: 0, wrong: 0, unknown: 0 };
for (const s of samples) algo[algoOutcome(s, rule.get(s.id)!.algorithm) as keyof typeof algo]++;
const perAlgo = [...new Set(samples.map((s) => s.algorithm))].map((a) => {
  const ss = samples.filter((s) => s.algorithm === a);
  const ok = ss.filter((s) => rule.get(s.id)!.category === s.category).length;
  const named = ss.filter((s) => algoOutcome(s, rule.get(s.id)!.algorithm) === "right").length;
  return `| ${a} | ${ss[0].category} | ${ok}/${ss.length} | ${named}/${ss.length} |`;
});

let md = `# Detection engine report: ${setName} set\n\n${samples.length} real samples (${samples.filter((s) => s.encoding === "hex").length} hex, ${samples.filter((s) => s.encoding === "base64").length} Base64), generated by eval/gen.mjs and decrypted back before saving.\n\n`;
md += `## 1. Category classification (rule engine, all samples)\n\n${metricsMd("Rule engine", ruleM)}\n`;
const SHARED = new Set([32, 48, 64]); // a hash size AND a common ciphertext size
for (const [name, keep] of [["Lengths shared by hashes and ciphertext (32, 48 or 64 bytes)", true], ["All other lengths", false]] as const) {
  const sub = samples.filter((s) => SHARED.has(s.bytes) === keep);
  const r = metrics(sub.map((s) => ({ truth: s.category, pred: rule.get(s.id)!.category })));
  md += `- ${name}: ${sub.length} samples, accuracy ${pct(r.accuracy)}, wrong category ${sub.length - r.correct - (sub.length - r.answered)}, UNKNOWN ${sub.length - r.answered}\n`;
  console.log(`  ${name}: ${sub.length} samples, accuracy ${pct(r.accuracy)}, UNKNOWN ${sub.length - r.answered}`);
}
md += "\n";
md += `## 2. Algorithm identification (rule engine)\n\nSeparate from the category: naming the exact algorithm.\n\n- Named correctly: ${algo.right}\n- Named wrongly: ${algo.wrong}\n- UNKNOWN (honestly not identifiable): ${algo.unknown}\n\n`;
md += `| Algorithm | Category | Category correct | Algorithm named correctly |\n|---|---|---:|---:|\n${perAlgo.join("\n")}\n\n`;

// ---- AI engine (subset), if results exist
const aiRows: string[] = [];
for (const [file, title] of [["ai-before.json", "Claude engine, before (no rules)"], ["ai-after.json", "Claude engine, after (rules + Claude)"]]) {
  const f = path.join(here, "data", file);
  if (!fs.existsSync(f) || setName !== "test") continue;
  const ai: (Pred & { id: string })[] = JSON.parse(fs.readFileSync(f, "utf8"));
  const ids = new Set(ai.map((a) => a.id)), sub = samples.filter((s) => ids.has(s.id));
  const aiM = metrics(sub.map((s) => ({ truth: s.category, pred: ai.find((a) => a.id === s.id)!.category })));
  const rM = metrics(sub.map((s) => ({ truth: s.category, pred: rule.get(s.id)!.category })));
  aiRows.push(`${metricsMd(`${title}: ${sub.length} samples`, aiM)}\n${metricsMd(`Rule engine on the same ${sub.length} samples`, rM)}`);
  aiRows.push(`<details><summary>Every answer (${title})</summary>\n\n| Sample | Algorithm | Encoding | Expected | Claude said | Confidence | Claude's algorithm | Result |\n|---|---|---|---|---|---|---|---|\n` +
    sub.map((s) => { const a = ai.find((x) => x.id === s.id)!; return `| ${s.id} | ${s.algorithm} | ${s.encoding} | ${label(s.category)} | ${label(a.category)} | ${a.confidence} | ${a.algorithm.replace(/\|/g, "/")} | ${a.category === s.category ? "Correct" : "Incorrect"} |`; }).join("\n") + "\n\n</details>\n");
}
if (aiRows.length) md += `## 3. Claude engine vs rule engine (same samples)\n\n${aiRows.join("\n")}\n`;

md += `## ${aiRows.length ? 4 : 3}. Every sample (rule engine)\n\n| Sample | Original algorithm | Plaintext length | Encoding | Input value (complete) | Expected | Detected | Confidence | Detected algorithm | Result |\n|---|---|---:|---|---|---|---|---:|---|---|\n`;
md += samples.map((s) => {
  const c = rule.get(s.id)!;
  return `| ${s.id} | ${s.algorithm} | ${Buffer.byteLength(s.plaintext)} | ${s.encoding} | \`${s.value}\` | ${label(s.category)} | ${label(c.category)} | ${c.categoryConfidence.toFixed(2)} | ${c.algorithm} | ${c.category === s.category ? "Correct" : "Incorrect"} |`;
}).join("\n") + "\n";

fs.writeFileSync(path.join(here, `report-${setName}.md`), md);
console.log(`${setName}: accuracy ${pct(ruleM.accuracy)} · coverage ${pct(ruleM.coverage)} · accuracy when answered ${pct(ruleM.selective)}`);
for (const p of ruleM.per) console.log(`  ${label(p.c).padEnd(10)} P ${pct(p.precision)}  R ${pct(p.recall)}  F1 ${pct(p.f1)}`);
console.log("  confusion:", JSON.stringify(ruleM.m));
console.log("  algorithm named right/wrong/unknown:", algo.right, algo.wrong, algo.unknown);
const wrong = samples.filter((s) => rule.get(s.id)!.category !== s.category);
for (const s of wrong) console.log(`  ✗ ${s.algorithm} ${s.encoding} pt=${Buffer.byteLength(s.plaintext)}B ${s.bytes}B -> ${rule.get(s.id)!.category}`);
